{
  "name": "@rn-unified-ui/tokens",
  "version": "0.0.1",
  "description": "Design token system for React Native Unified UI Framework",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tokens.json": "./tokens/base.json"
  },
  "files": [
    "dist",
    "tokens"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@rn-unified-ui/eslint-config": "workspace:*",
    "@types/react": "^18.2.55",
    "eslint": "^8.57.1",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "theming",
    "tokens"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
