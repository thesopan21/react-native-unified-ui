{
  "name": "@rn-unified-ui/core",
  "version": "0.0.1",
  "description": "Core UI primitives for React Native Unified UI Framework",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.73.0"
  },
  "devDependencies": {
    "@rn-unified-ui/eslint-config": "workspace:*",
    "@types/react": "^18.2.55",
    "@types/react-native": "^0.73.0",
    "eslint": "^8.57.1",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "react-native",
    "ui",
    "components",
    "fabric",
    "cross-platform"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}