{
  "name": "rn-unified-ui",
  "version": "0.0.0",
  "private": true,
  "description": "A modern React Native UI framework for building consistent cross-platform applications",
  "keywords": [
    "react-native",
    "fabric",
    "turbo-modules",
    "design-system",
    "ui-framework",
    "cross-platform"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/rn-unified-ui.git"
  },
  "license": "MIT",
  "author": "RN Unified UI Contributors",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "^20.11.19",
    "eslint": "^8.57.1",
    "prettier": "^3.2.5",
    "turbo": "^1.12.4",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@8.15.3",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
